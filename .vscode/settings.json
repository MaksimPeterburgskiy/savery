{
	// Use the backend's virtualenv if present
	"python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
	// Keep terminals readable for long-running debug sessions
	"terminal.integrated.defaultProfile.osx": "bash",
	"cSpell.enabledLanguageIds": ["COBOL", "ACUCOBOL"],
	"python.testing.pytestArgs": ["backend"],
	"python.testing.unittestEnabled": false,
	"python.testing.pytestEnabled": true,

	"terminal.integrated.tabs.title": "${task}",

	"debug.toolBarLocation": "floating",

	"debug.showSubSessionsInToolBar": false,
	"sqltools.connections": [
		{
			"ssh": "Disabled",
			"previewLimit": 50,
			"server": "localhost",
			"port": 5432,
			"driver": "PostgreSQL",
			"name": "savery local",
			"database": "savery",
			"username": "postgres",
			"password": "postgres"
		}
	],
	"python.languageServer": "None"
}

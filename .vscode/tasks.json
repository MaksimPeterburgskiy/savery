{
  // See https://code.visualstudio.com/docs/editor/tasks for format docs
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start cloudflare tunnel (backend)",
      "type": "shell",
      "command": "bash",
      "args": ["-lc", "${workspaceFolder}/.vscode/scripts/start_cloudflare_tunnel_backend.sh"],
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "savery",
          "pattern": [
            {
              "regexp": "^(a)(b)(c)$",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^SAVERY_TUNNEL_STARTING$",
            "endsPattern": "^SAVERY_TUNNEL_READY\\s+https://.*$"
          }
        }
      ],
      "presentation": {
        "group": "savery: cloudflare tunnel",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-Command",
          "Write-Error 'Cloudflare tunnel task is only configured for macOS/Linux shells.'"
        ]
      }
    },
    {
      "label": "ensure docker desktop running",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "set -euo pipefail; if ! command -v docker >/dev/null 2>&1; then echo \"Docker CLI not found; install Docker Desktop.\" >&2; exit 1; fi; if docker info >/dev/null 2>&1; then echo \"Docker is ready.\"; exit 0; fi; echo \"Docker isn't ready yet; trying to start Docker Desktop...\"; docker desktop start || true; for i in {1..30}; do if docker info >/dev/null 2>&1; then echo \"Docker is ready.\"; exit 0; fi; sleep 2; done; echo \"Docker Desktop did not become ready in time.\" >&2; exit 1"
      ],
      "problemMatcher": [],
      "presentation": {
        "group": "savery: docker",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "powershell",
				"args": ["-NoProfile", "-NonInteractive", "-Command", "exit 0"]
      }
    },
    {
      "label": "start dragonfly",
			//   "dependsOn": [
			//     "ensure docker desktop running"
			//   ],
      "type": "shell",
      "command": "bash",
      "args": ["-lc", "${workspaceFolder}/.vscode/scripts/start_dragonfly.sh"],
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "savery",
          "pattern": [
            {
              "regexp": "^(a)(b)(c)$",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^SAVERY_DRAGONFLY_STARTING$",
            "endsPattern": "^SAVERY_DRAGONFLY_READY$"
          }
        }
      ],

      "presentation": {
        "group": "savery: dragonfly",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-Command",
          "docker container inspect 'savery-dragonfly' > $null 2>&1; if ($LASTEXITCODE -eq 0) { docker start 'savery-dragonfly' | Out-Null } else { docker run -d --name 'savery-dragonfly' -p 6379:6379 --ulimit memlock=-1 docker.dragonflydb.io/dragonflydb/dragonfly --proactor_threads=2 | Out-Null }"
        ]
      }
    },
    {
      "label": "start postgres",
			//   "dependsOn": [
			//     "ensure docker desktop running"
			//   ],
      "type": "shell",
      "command": "bash",
      "args": ["-lc", "${workspaceFolder}/.vscode/scripts/start_postgres.sh"],
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "savery",
          "pattern": [
            {
              "regexp": "^(a)(b)(c)$",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^SAVERY_POSTGRES_STARTING$",
            "endsPattern": "^SAVERY_POSTGRES_READY$"
          }
        }
      ],
      "presentation": {
        "group": "savery: postgres",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-Command",
          "if (-not (docker image inspect 'savery/postgres-postgis-pgvector:local' > $null 2>&1)) { docker build -t 'savery/postgres-postgis-pgvector:local' -f infra/docker/postgres-pgvector.Dockerfile infra/docker | Out-Null } docker container inspect 'savery-postgres' > $null 2>&1; if ($LASTEXITCODE -eq 0) { docker start 'savery-postgres' | Out-Null } else { docker run -d --name 'savery-postgres' -p 5432:5432 -e POSTGRES_DB=savery -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres 'savery/postgres-postgis-pgvector:local' | Out-Null }"
        ]
      }
    },
    {
      "label": "start rabbitmq",
			//   "dependsOn": [
			//     "ensure docker desktop running"
			//   ],
      "type": "shell",
      "command": "bash",
			"args": ["-lc", "${workspaceFolder}/.vscode/scripts/start_rabbitmq.sh"],
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "savery",
          "pattern": [
            {
              "regexp": "^(a)(b)(c)$",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^SAVERY_RABBITMQ_STARTING$",
            "endsPattern": "^SAVERY_RABBITMQ_READY$"
          }
        }
      ],
      "presentation": {
        "group": "savery: rabbitmq",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-Command",
          "docker container inspect 'savery-rabbit' > $null 2>&1; if ($LASTEXITCODE -eq 0) { docker start 'savery-rabbit' | Out-Null } else { docker run -d --name 'savery-rabbit' -p 5672:5672 -p 15672:15672 rabbitmq:3-management | Out-Null }"
        ]
      }
    },
    {
      "label": "terminate uvicorn web api",
      "type": "shell",
      "command": "bash",
			"args": ["-lc", "pkill -f \"uvicorn.*backend\\.app\\.main:app\" >/dev/null 2>&1 || true"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never"
      },
      "windows": {
        "command": "powershell",
				"args": ["-NoProfile", "-NonInteractive", "-Command", "exit 0"]
      }
    },
    {
      "label": "terminate celery worker",
      "type": "shell",
      "command": "bash",
			"args": ["-lc", "pkill -f \"celery.*backend\\.workers\\.celery_app:celery_app\" >/dev/null 2>&1 || true"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never"
      },
      "windows": {
        "command": "powershell",
				"args": ["-NoProfile", "-NonInteractive", "-Command", "exit 0"]
      }
    },
    {
      "label": "start services (postgres+rabbitmq+dragonfly)",
			"dependsOn": ["start postgres", "start rabbitmq", "start dragonfly", "start cloudflare tunnel (backend)"],
      "problemMatcher": [],
      "presentation": {
        "group": "savery: services",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "stop services (postgres+rabbitmq+dragonfly)",
      "type": "shell",
      "command": "bash",
			"args": ["-lc", "docker stop savery-postgres savery-rabbit savery-dragonfly 2>/dev/null || true; pkill -f \"cloudflared tunnel --url http://localhost:8000\" >/dev/null 2>&1 || true"],
      "problemMatcher": [],
      "presentation": {
        "group": "savery: stop services",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "powershell",
				"args": ["-NoProfile", "-NonInteractive", "-Command", "docker stop savery-postgres savery-rabbit savery-dragonfly 2>$null | Out-Null; if ($LASTEXITCODE -ne 0) { $global:LASTEXITCODE = 0 }"]
      }
    }
  ]
}
